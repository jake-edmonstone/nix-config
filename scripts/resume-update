#!/usr/bin/env bash
set -euo pipefail

WORK_DIR="${TYPST_ROOT:-$HOME/work}"
PROFESSIONAL_DIR="$WORK_DIR/professional"
WEBSITE_DIR="$HOME/projects/jake-edmonstone.github.io"
WEBSITE_DOCUMENTS_DIR="$WEBSITE_DIR/documents"
DATE=$(date +%Y-%m-%d)

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

echo "Compiling resume and cv..."
typst compile --root "$WORK_DIR" "$PROFESSIONAL_DIR/resume.typ" "$tmpdir/resume.pdf"
typst compile --root "$WORK_DIR" "$PROFESSIONAL_DIR/cv.typ" "$tmpdir/cv.pdf"

cp "$tmpdir/resume.pdf" "$WEBSITE_DOCUMENTS_DIR/resume.pdf"
cp "$tmpdir/cv.pdf" "$WEBSITE_DOCUMENTS_DIR/cv.pdf"

work_paths=(
  professional/resume.typ
  professional/cv.typ
  professional/shared.typ
)
echo "Committing work repo..."
git -C "$WORK_DIR" add -- "${work_paths[@]}"
if git -C "$WORK_DIR" diff --cached --quiet -- "${work_paths[@]}"; then
  echo "No resume/cv changes in work repo"
else
  git -C "$WORK_DIR" commit --only -m "update resume $DATE" -- "${work_paths[@]}"
fi

website_paths=(documents/resume.pdf documents/cv.pdf)
echo "Committing website repo..."
git -C "$WEBSITE_DIR" add -- "${website_paths[@]}"
if git -C "$WEBSITE_DIR" diff --cached --quiet -- "${website_paths[@]}"; then
  echo "No PDF changes in website repo"
else
  git -C "$WEBSITE_DIR" commit --only -m "update resume and cv $DATE" -- "${website_paths[@]}"
fi

git -C "$WORK_DIR" push
git -C "$WEBSITE_DIR" push

echo "Done!"
