#!/usr/bin/env bash
set -euo pipefail

WORK_DIR="${TYPST_ROOT:-$HOME/work}"
WEBSITE_DIR="$HOME/projects/jake-edmonstone.github.io"
WEBSITE_NOTES_REL="documents/course-notes"
DATE=$(date +%Y-%m-%d)

COURSE_PATHS=(
)

tmpdir="$(mktemp -d)"
source_tmps=()
cleanup() {
  rm -rf "$tmpdir"
  if [[ ${#source_tmps[@]} -gt 0 ]]; then
    rm -f "${source_tmps[@]}"
  fi
}
trap cleanup EXIT

note_paths=()
pdfs=()
compiled_pdfs=()

for course_path in "${COURSE_PATHS[@]}"; do
  course="${course_path##*/}"
  main="$WORK_DIR/$course_path/notes/main.typ"
  note_paths+=("$course_path/notes")
  pdfs+=("$WEBSITE_NOTES_REL/${course}-notes.pdf")
  compiled_pdfs+=("$tmpdir/${course}-notes.pdf")

  echo "Compiling $course..."

  # Keep the temporary source beside main.typ so relative imports resolve.
  tmp_base="$(mktemp "$(dirname "$main")/.main_website.XXXXXX")"
  source_tmps+=("$tmp_base")
  tmp="$tmp_base.typ"
  mv "$tmp_base" "$tmp"
  source_tmps+=("$tmp")
  sed -e '/show: preamble/a\
#set text(12pt)
' "$main" >"$tmp"

  typst compile --root "$WORK_DIR" "$tmp" "$tmpdir/${course}-notes.pdf"
  rm -f "$tmp"
done

# Do not update the website unless every course compiled successfully.
for i in "${!pdfs[@]}"; do
  cp "${compiled_pdfs[$i]}" "$WEBSITE_DIR/${pdfs[$i]}"
done

echo "Committing work repo..."
git -C "$WORK_DIR" add -- "${note_paths[@]}"
if git -C "$WORK_DIR" diff --cached --quiet -- "${note_paths[@]}"; then
  echo "No note changes in work repo"
else
  git -C "$WORK_DIR" commit --only -m "update notes $DATE" -- "${note_paths[@]}"
fi

echo "Committing website repo..."
git -C "$WEBSITE_DIR" add -- "${pdfs[@]}"
if git -C "$WEBSITE_DIR" diff --cached --quiet -- "${pdfs[@]}"; then
  echo "No note PDF changes in website repo"
else
  git -C "$WEBSITE_DIR" commit --only -m "update notes $DATE" -- "${pdfs[@]}"
fi

git -C "$WORK_DIR" push
git -C "$WEBSITE_DIR" push

echo "Done!"
